# Data: never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Secrets
.env
.env.*
*.pem
*.key
credentials.json

# Trained artifacts. models/model.pkl, models/model_card.json and
# models/serving_features.pkl ARE committed: the Docker image is built from a
# git checkout and the app needs them to serve. Other experiment pickles are not.
models/*.pkl
models/*.joblib
!models/model.pkl
!models/serving_features.pkl

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Tuning / framework scratch dirs
structured_data_regressor/
kerastuner_mlp/
untitled_project/

# OS / editor
.DS_Store
.vscode/
.idea/
