# Data: never committed
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Secrets
.env
.env.*
*.pem
*.key
credentials.json

# Trained artefacts. The per-crop models under models/<crop>/ ARE committed, along
# with models/index.json and models/weekly_snapshot.csv: the Docker image is built
# from a git checkout and the app needs all three to serve. Stray experiment pickles
# dropped at the models/ root are not.
models/*.pkl
models/*.joblib

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Tuning / framework scratch dirs
structured_data_regressor/
kerastuner_mlp/
untitled_project/

# OS / editor
.DS_Store
.vscode/
.idea/
